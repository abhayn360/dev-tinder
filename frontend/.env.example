# Vite only exposes variables that start with VITE_ to the browser.
# Everything here ends up PUBLIC in the JS bundle, so never put secrets in it.

# Default "/api/v1" uses the Vite dev proxy (see vite.config.js).
# In production set it to your API's URL, e.g. https://api.devtinder.com/api/v1
VITE_API_URL=/api/v1
